# Copy to .env (never commit it). Values marked "secret" come from `openssl rand -hex 32`.

# Public names, both A records pointing to this server.
DOMAIN=maccheri.example.com
TURN_DOMAIN=turn.maccheri.example.com
ACME_EMAIL=you@example.com

# coturn shared secret (secret). The control plane signs short-lived TURN credentials with it.
TURN_SECRET=
# Only if the server sits behind 1:1 NAT (some clouds): its public IP, or "public/private".
TURN_EXTERNAL_IP=
TURN_MIN_PORT=49160
TURN_MAX_PORT=49999

# Team access (secret): web client and Maccheri.app send it as `Authorization: Bearer ...` on /v1/*.
MACCHERI_SHARED_TOKEN=

# Optional personal accounts. First admin: redeem this code in the web client, then remove it (secret).
# Alternative: docker compose exec controlplane /app/controlplane create-invite --admin
ADMIN_INVITE=

# Sessions
SESSION_MINUTES=60
MAX_SESSIONS_PER_USER=2

# CI through the GitHub App (C registers it). Leave empty to run without CI.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# PEM with literal newlines replaced by \n, or mount a file and use GITHUB_APP_PRIVATE_KEY_FILE.
GITHUB_APP_PRIVATE_KEY=
RUNNER_LABEL=maccheri
DEFAULT_IMAGE=macos-27-xcode-27.2-v1

LOG_LEVEL=info
