# Copy to .env.local (ignored by git). See deploy/README.md, "Локально".

# The Mac's Bonjour name in lower case (scutil --get LocalHostName, plus .local) and LAN address (ipconfig getifaddr en0).
DOMAIN=mac-mini-artem.local
LAN_IP=10.10.20.86

# Team access (secret): openssl rand -hex 32
MACCHERI_SHARED_TOKEN=

# TURN only with --profile turn; leave empty otherwise.
TURN_DOMAIN=
TURN_SECRET=

DEFAULT_IMAGE=macos-27-xcode-27.2-v2
SESSION_MINUTES=60
LOG_LEVEL=info
