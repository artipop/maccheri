<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.maccheri.runner</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/maccheri-runner.sh</string>
	</array>
	<!-- The runner must not run as root; "admin" is the default user in Tart's images. -->
	<key>UserName</key>
	<string>admin</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/admin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/maccheri-runner.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/maccheri-runner.log</string>
</dict>
</plist>
